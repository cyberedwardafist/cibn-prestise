# Salin file ini menjadi .env lalu sesuaikan nilainya. JANGAN commit file .env ke git.

# Wajib — connection string PostgreSQL.
# Format umum: postgres://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# Contoh lokal:   postgres://postgres:postgres@localhost:5432/cibn_prestise
# Contoh managed (Railway/Render/Supabase/Neon/dll): salin dari dashboard provider.
DATABASE_URL=postgresql://postgres:Garminn%40250@db.jndhczzvbydxodxpxfgs.supabase.co:5432/postgres

# Wajib untuk produksi — kunci rahasia untuk menandatangani JWT login.
# Isi dengan string acak yang panjang & rahasia. JANGAN pakai nilai contoh di bawah ini.
JWT_SECRET=f39b3bf6-dee9-4ca9-9e24-80848fb197be

# Opsional — port server Express (default: 3000)
PORT=3000

# Opsional — aktifkan SSL ke PostgreSQL (true/false).
# Default: otomatis "true" kalau NODE_ENV=production, "false" kalau tidak.
# Kebanyakan provider managed Postgres (Railway, Render, Supabase, Neon, RDS) WAJIB true.
PGSSL=true

# Opsional — jumlah maksimum koneksi dalam connection pool (default: 10)
# PG_POOL_MAX=10

# Opsional — hanya dipakai oleh db/migrate-from-sqlite.js untuk menunjuk lokasi
# file database SQLite LAMA yang mau dipindahkan datanya.
# Default: db/legacy-sqlite/cibn_prestise.db
# SQLITE_PATH=db/legacy-sqlite/cibn_prestise.db

SUPABASE_URL=https://jndhczzvbydxodxpxfgs.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpuZGhjenp2YnlkeG9keHB4ZmdzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc5MDUwNDcsImV4cCI6MjA5MzQ4MTA0N30.tOto2JUlWO1GK4yp25LuII7Ha5wgKe73QQeWHPEjK28
